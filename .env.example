# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_development_secret
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (Neon/Supabase/Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/studio_elan

# Stripe (mode test / démo)
# STRIPE_DEMO_MODE doit rester à 0 pour les environnements de production/staging.
# Mettez STRIPE_DEMO_MODE=1 uniquement pour les démos locales : les routes utilisent alors un faux checkout
# et des webhooks simulés (protégés par STRIPE_DEMO_WEBHOOK_SECRET).
STRIPE_DEMO_MODE=0
STRIPE_SECRET_KEY=sk_test_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
# Secret utilisé uniquement pour les webhooks de démo Stripe.
# Ne pas réutiliser cette valeur en production; utilisez une chaîne aléatoire forte pour vos tests locaux.
STRIPE_DEMO_WEBHOOK_SECRET=change_me_demo_only

# Email (demo-friendly: Mailtrap SMTP OR Resend)
# -- Mailtrap SMTP (recommended for demo inbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@demo.local

# -- Or Resend (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@your-domain.com

# Telegram notifications (preferred over WhatsApp for demo)
# Create a bot with @BotFather, then get your chat id using @userinfobot or a small helper
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional analytics/monitoring
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Rate limiting / proxy
# Définir à 1 uniquement si l'application est derrière un proxy/load balancer de confiance (Vercel, Netlify, Nginx...).
# Permet de faire confiance à l'en-tete X-Forwarded-For pour le rate limiting.
RATE_LIMIT_TRUST_PROXY=0

# Notifications (route de test)
# Secret partagé pour protéger la route de test de notifications.
# Utiliser une chaîne aléatoire forte, différente de vos autres secrets.
NOTIFICATIONS_TEST_SECRET=change_me_notifications_test_only

# Prisma seed users (admin + client)
# Ces variables contrôlent les comptes créés par les scripts de seed Prisma.
# En développement, les identifiants par défaut facilitent les tests locaux.
# En production, les scripts refuseront de s'exécuter si ces variables ne sont pas définies explicitement.
# ⚠️ Ne JAMAIS utiliser d'identifiants faibles ou connus en production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_admin_password
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=change_me_strong_client_password